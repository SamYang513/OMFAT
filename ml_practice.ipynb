      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Set style for plots 選圖風\n",
        "sns.set_style('whitegrid')\n",
        "\n",
        "# Get numerical and categorical columns 取得數值、分類型的欄位\n",
        "numerical_cols = df_full.select_dtypes(include = ['int64', 'float64']).columns\n",
        "categorical_cols = df_full.select_dtypes(include = ['object']).columns\n",
        "\n",
        "# Plot histograms for numerical features 把數值型的畫成直方圖\n",
        "print('Plotting Histograms for Numerical Features...')\n",
        "plt.figure( figsize = (15, 10) )\n",
        "for i, col in enumerate(numerical_cols):\n",
        "    plt.subplot(3, 6, i + 1) # Adjust subplot grid as needed\n",
        "    sns.histplot(df_full[col], kde = True) # KDE: Kernel Density Estimate\n",
        "    plt.title(f'Distribution of {col}')\n",
        "    plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Plot countplots for categorical features 把類別型點出來\n",
        "print('\\nPlotting Countplots for Categorical Features...')\n",
        "plt.figure( figsize = (15, 10) )\n",
        "for i, col in enumerate(categorical_cols):\n",
        "    plt.subplot(3, 6, i + 1) # Adjust subplot grid as needed\n",
        "    sns.countplot(y = df_full[col], order = df_full[col].value_counts().index)\n",
        "    plt.title(f'Count of {col}')\n",
        "    plt.tight_layout()\n",
        "plt.show()"
      ]
    },
